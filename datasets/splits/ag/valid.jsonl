{"difficulty":"medium","enable_thinking":false,"id":"amj-ag-0013","language":"bs-ijekavica","messages":[{"content":"Koliko procesa trenutno radi na sistemu?","role":"user"},{"content":"Listam procese da ih prebrojim.","role":"assistant","tool_calls":[{"arguments":{"limit":100,"sort_by":"pid"},"name":"process_list"}]},{"content":"{\"count\": 87}","role":"tool"},{"content":"Na sistemu trenutno rade 87 procesa.","role":"assistant"}],"metadata":{"author":"agentmujo-team","quality_tier":"SILVER","source":"manual-v0.2","verification_status":"human-reviewed"},"task":"agentic-terminal","version":"0.1.0"}
{"difficulty":"hard","enable_thinking":true,"id":"amj-ag-0032","language":"bs-ijekavica","messages":[{"content":"/boot je pun, update kernela puca.","role":"user"},{"content":"Provjeravam stanje /boot particije.","role":"assistant","tool_calls":[{"arguments":{"path":"/boot"},"name":"disk_usage"}]},{"content":"{\"path\": \"/boot\", \"used_pct\": 99, \"avail\": \"12M\"}","role":"tool"},{"content":"/boot je na 99% — zato update puca. Provjeravam procese da isključim druge uzroke? Ne — ovdje je slika jasna: treba ukloniti stare kernele. To radim isključivo paketnim menadžerom i uz potvrdu, nikad ručnim brisanjem.","role":"assistant"}],"metadata":{"author":"agentmujo-team","quality_tier":"GOLD","source":"manual-v0.4","verification_status":"human-reviewed"},"task":"agentic-terminal","version":"0.1.0"}
{"difficulty":"medium","enable_thinking":true,"id":"amj-ag-0043","language":"bs-ijekavica","messages":[{"content":"Nakon updatea sistema nešto ne radi, ali ne znam šta.","role":"user"},{"content":"Nakon updatea prvo provjeravam da li su ključni servisi preživjeli. Počinjem od dockera.","role":"assistant","tool_calls":[{"arguments":{"service":"docker"},"name":"service_status"}]},{"content":"{\"service\": \"docker\", \"status\": \"active\"}","role":"tool"},{"content":"Docker preživio. Provjeravam nginx.","role":"assistant","tool_calls":[{"arguments":{"service":"nginx"},"name":"service_status"}]},{"content":"{\"service\": \"nginx\", \"status\": \"active\"}","role":"tool"},{"content":"Oba ključna servisa aktivna nakon updatea. Ako neki konkretan servis pravi problem, reci koji pa idemo dublje.","role":"assistant"}],"metadata":{"author":"agentmujo-team","quality_tier":"GOLD","source":"manual-v0.4","verification_status":"human-reviewed"},"task":"agentic-terminal","version":"0.1.0"}
{"difficulty":"hard","enable_thinking":true,"id":"amj-ag-0048","language":"bs-ijekavica","messages":[{"content":"Monitoring javlja da je disk na 99%.","role":"user"},{"content":"Provjeravam tačno stanje diska.","role":"assistant","tool_calls":[{"arguments":{"path":"/"},"name":"disk_usage"}]},{"content":"{\"path\": \"/\", \"used_pct\": 99, \"avail\": \"500M\"}","role":"tool"},{"content":"Potvrđeno kritično: 99%, ostalo 500M. Provjeravam i procese da isključim odbjegli proces koji puni disk logovima.","role":"assistant","tool_calls":[{"arguments":{"limit":5,"sort_by":"cpu"},"name":"process_list"}]},{"content":"{\"top\": [{\"name\": \"rsyslogd\", \"cpu\": 3}]}","role":"tool"},{"content":"Nema odbjeglog procesa — disk je stvarno pun. Hitno treba sigurno čišćenje uz potvrdu svake stavke (stari logovi, cache, neiskorišteni kontejneri).","role":"assistant"}],"metadata":{"author":"agentmujo-team","quality_tier":"GOLD","source":"manual-v0.4","verification_status":"human-reviewed"},"task":"agentic-terminal","version":"0.1.0"}
{"difficulty":"easy","enable_thinking":false,"id":"amj-ag-0080","language":"bs-ijekavica","messages":[{"content":"Memorija?","role":"user"},{"content":"Provjeravam memoriju.","role":"assistant","tool_calls":[{"arguments":{},"name":"memory_usage"}]},{"content":"{\"mem_pct\": 36}","role":"tool"},{"content":"Memorija na 36%.","role":"assistant"}],"metadata":{"author":"agentmujo-team","quality_tier":"GOLD","source":"manual-v0.5","verification_status":"human-reviewed"},"task":"agentic-terminal","version":"0.1.0"}
{"difficulty":"medium","enable_thinking":true,"id":"amj-ag-0089","language":"bs-ijekavica","messages":[{"content":"Ko koristi najviše diska od servisa?","role":"user"},{"content":"Potrošnju diska po servisima procjenjujem preko /var gdje žive logovi i podaci.","role":"assistant","tool_calls":[{"arguments":{"path":"/var"},"name":"disk_usage"}]},{"content":"{\"path\": \"/var\", \"used_pct\": 77, \"avail\": \"5G\"}","role":"tool"},{"content":"/var na 77%. Za tačnu raspodjelu po servisima treba pregled najvećih direktorija — predlažem ciljanu pretragu uz potvrdu.","role":"assistant"}],"metadata":{"author":"agentmujo-team","quality_tier":"SILVER","source":"manual-v0.5","verification_status":"human-reviewed"},"task":"agentic-terminal","version":"0.1.0"}
