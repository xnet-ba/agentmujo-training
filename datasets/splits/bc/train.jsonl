{"difficulty":"easy","enable_thinking":false,"id":"amj-bc-0008","language":"bs-ijekavica","messages":[{"content":"Sastavi tri rečenice sa riječju 'mlijeko'.","role":"user"},{"content":"1. Svako jutro pijem čašu toplog mlijeka. 2. Za kolač nam treba pola litra mlijeka. 3. Svježe mlijeko čuvaj u frižideru.","role":"assistant"}],"metadata":{"author":"agentmujo-team","quality_tier":"GOLD","source":"manual-v0.9-core","verification_status":"human-reviewed"},"task":"bosnian-core","version":"0.1.0"}
{"difficulty":"easy","enable_thinking":false,"id":"amj-bc-0009","language":"bs-ijekavica","messages":[{"content":"Objasni djetetu šta je internet.","role":"user"},{"content":"Internet je velika mreža koja povezuje kompjutere i telefone širom svijeta. Preko njega možeš gledati filmove, slati poruke prijateljima i učiti nove stvari.","role":"assistant"}],"metadata":{"author":"agentmujo-team","quality_tier":"GOLD","source":"manual-v0.9-core","verification_status":"human-reviewed"},"task":"bosnian-core","version":"0.1.0"}
