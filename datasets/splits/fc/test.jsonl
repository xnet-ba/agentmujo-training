{"difficulty":"easy","enable_thinking":false,"id":"amj-fc-0079","language":"bs-ijekavica","messages":[{"content":"Šta je swap i kada se koristi?","role":"user"},{"content":"Swap je prostor na disku koji sistem koristi kao proširenje RAM-a kad memorije ponestane. Prekomjerno korištenje swap-a usporava sistem. Odgovaram iz znanja, bez alata.","role":"assistant"}],"metadata":{"author":"agentmujo-team","quality_tier":"GOLD","source":"manual-v0.4","verification_status":"human-reviewed"},"task":"function-calling","version":"0.1.0"}
