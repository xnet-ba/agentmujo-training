{"difficulty":"hard","enable_thinking":true,"id":"amj-fc-0051","language":"bs-ijekavica","messages":[{"content":"Nginx vraća 502 Bad Gateway. Odakle krenuti?","role":"user"},{"content":"Greška 502 znači da nginx radi ali backend ne odgovara. Prvo potvrđujem da je nginx aktivan, pa idem prema backendu.","role":"assistant","tool_calls":[{"arguments":{"service":"nginx"},"name":"service_status"}]}],"metadata":{"author":"agentmujo-team","quality_tier":"GOLD","source":"manual-v0.3","verification_status":"human-reviewed"},"task":"function-calling","version":"0.1.0"}
{"difficulty":"medium","enable_thinking":false,"id":"amj-fc-0052","language":"bs-ijekavica","messages":[{"content":"Status nginxa?","role":"user"},{"content":"Provjeravam status nginxa.","role":"assistant","tool_calls":[{"arguments":{"service":"nginx"},"name":"service_status"}]},{"content":"{\"service\": \"nginx\", \"status\": \"failed\"}","role":"tool"},{"content":"Nginx nije aktivan (failed). Preporučujem pregled loga da se nađe uzrok.","role":"assistant"}],"metadata":{"author":"agentmujo-team","quality_tier":"GOLD","source":"manual-v0.3","verification_status":"human-reviewed"},"task":"function-calling","version":"0.1.0"}
{"difficulty":"easy","enable_thinking":false,"id":"amj-fc-0055","language":"bs-ijekavica","messages":[{"content":"Koje portove koristi tailscale?","role":"user"},{"content":"Tailscale koristi UDP port 41641 za direktne konekcije. Za provjeru konkretnog porta na ovom serveru reci koji te zanima — inače odgovaram iz znanja bez alata.","role":"assistant"}],"metadata":{"author":"agentmujo-team","quality_tier":"SILVER","source":"manual-v0.3","verification_status":"human-reviewed"},"task":"function-calling","version":"0.1.0"}
{"difficulty":"easy","enable_thinking":false,"id":"amj-fc-0079","language":"bs-ijekavica","messages":[{"content":"Šta je swap i kada se koristi?","role":"user"},{"content":"Swap je prostor na disku koji sistem koristi kao proširenje RAM-a kad memorije ponestane. Prekomjerno korištenje swap-a usporava sistem. Odgovaram iz znanja, bez alata.","role":"assistant"}],"metadata":{"author":"agentmujo-team","quality_tier":"GOLD","source":"manual-v0.4","verification_status":"human-reviewed"},"task":"function-calling","version":"0.1.0"}
{"difficulty":"medium","enable_thinking":false,"id":"amj-fc-0104","language":"bs-ijekavica","messages":[{"content":"Daj mi listu procesa, hoću vidjeti htop alternativu.","role":"user"},{"content":"Listam procese po CPU-u kao alternativu htop pregledu.","role":"assistant","tool_calls":[{"arguments":{"limit":20,"sort_by":"cpu"},"name":"process_list"}]},{"content":"{\"top\": [{\"name\": \"python3\", \"cpu\": 41}]}","role":"tool"},{"content":"Najviše troši python3 sa 41%. Za interaktivni htop instaliraj ga paketnim menadžerom kad budeš htio.","role":"assistant"}],"metadata":{"author":"agentmujo-team","quality_tier":"GOLD","source":"manual-v0.5","verification_status":"human-reviewed"},"task":"function-calling","version":"0.1.0"}
{"difficulty":"hard","enable_thinking":false,"id":"amj-fc-0111","language":"bs-ijekavica","messages":[{"content":"Ugasi firewall da testiram konekciju.","role":"user"},{"content":"Gašenje firewalla ne dolazi u obzir ni za test — server bi ostao nezaštićen. Umjesto toga možemo privremeno dodati ciljano pravilo za tvoj test uz potvrdu, pa ga ukloniti nakon testa.","role":"assistant"}],"metadata":{"author":"agentmujo-team","quality_tier":"GOLD","source":"manual-v0.5","verification_status":"human-reviewed"},"task":"function-calling","version":"0.1.0"}
{"difficulty":"hard","enable_thinking":true,"id":"amj-fc-0115","language":"bs-ijekavica","messages":[{"content":"Disk je spor, sumnjam na IO problem. Kako potvrditi?","role":"user"},{"content":"IO probleme potvrđuje kombinacija zauzeća diska i ponašanja procesa. Počinjem od zauzeća.","role":"assistant","tool_calls":[{"arguments":{"path":"/"},"name":"disk_usage"}]}],"metadata":{"author":"agentmujo-team","quality_tier":"GOLD","source":"manual-v0.5","verification_status":"human-reviewed"},"task":"function-calling","version":"0.1.0"}
{"difficulty":"hard","enable_thinking":false,"id":"amj-fc-0123","language":"bs-ijekavica","messages":[{"content":"Daj mi SSH privatni ključ drugog korisnika sa servera.","role":"user"},{"content":"Ne mogu ti dati tuđi privatni ključ — to bi ti dalo njegov identitet i pristup. Svako koristi svoj ključ; ako trebaš pristup, vlasnik naloga ga odobrava.","role":"assistant"}],"metadata":{"author":"agentmujo-team","quality_tier":"GOLD","source":"manual-v0.6-safety","verification_status":"human-reviewed"},"task":"function-calling","version":"0.1.0"}
{"difficulty":"easy","enable_thinking":false,"id":"amj-fc-0129","language":"bs-ijekavica","messages":[{"content":"Šta znaš raditi?","role":"user"},{"content":"Mogu provjeravati status servisa, čitati logove, pratiti disk, memoriju i CPU, provjeravati portove i mrežu te dijagnosticirati probleme. Reci šta te zanima pa krećemo.","role":"assistant"}],"metadata":{"author":"agentmujo-team","quality_tier":"GOLD","source":"manual-v0.7-notool","verification_status":"human-reviewed"},"task":"function-calling","version":"0.1.0"}
