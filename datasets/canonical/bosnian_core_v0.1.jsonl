{"difficulty":"easy","enable_thinking":false,"id":"amj-bc-0001","language":"bs-ijekavica","messages":[{"content":"Objasni ukratko šta je fotosinteza.","role":"user"},{"content":"Fotosinteza je proces kojim biljke pomoću sunčeve svjetlosti pretvaraju ugljikov dioksid i vodu u glukozu i kisik. Odvija se u kloroplastima koji sadrže zeleni pigment hlorofil.","role":"assistant"}],"metadata":{"author":"agentmujo-team","quality_tier":"GOLD","source":"manual-v0.9-core","verification_status":"human-reviewed"},"task":"bosnian-core","version":"0.1.0"}
{"difficulty":"easy","enable_thinking":false,"id":"amj-bc-0002","language":"bs-ijekavica","messages":[{"content":"Napiši kratku čestitku za rođendan.","role":"user"},{"content":"Sretan rođendan! Želim ti puno zdravlja, sreće i uspjeha u svemu što radiš.","role":"assistant"}],"metadata":{"author":"agentmujo-team","quality_tier":"GOLD","source":"manual-v0.9-core","verification_status":"human-reviewed"},"task":"bosnian-core","version":"0.1.0"}
{"difficulty":"easy","enable_thinking":false,"id":"amj-bc-0003","language":"bs-ijekavica","messages":[{"content":"Šta znači riječ 'džep'?","role":"user"},{"content":"Džep je vrećasti dio odjeće u koji se stavljaju sitnice — npr. novac, ključevi ili telefon. U prenesenom značenju može označavati i izdvojeno mjesto ili rezervu.","role":"assistant"}],"metadata":{"author":"agentmujo-team","quality_tier":"GOLD","source":"manual-v0.9-core","verification_status":"human-reviewed"},"task":"bosnian-core","version":"0.1.0"}
{"difficulty":"medium","enable_thinking":false,"id":"amj-bc-0004","language":"bs-ijekavica","messages":[{"content":"Koji padež je u rečenici 'Vidim kuću'?","role":"user"},{"content":"To je akuzativ jednine — padež direktnog objekta. Glagol 'vidjeti' traži akuzativ: koga/šta vidim? Kuću.","role":"assistant"}],"metadata":{"author":"agentmujo-team","quality_tier":"GOLD","source":"manual-v0.9-core","verification_status":"human-reviewed"},"task":"bosnian-core","version":"0.1.0"}
{"difficulty":"medium","enable_thinking":false,"id":"amj-bc-0005","language":"bs-ijekavica","messages":[{"content":"Objasni razliku između 'da li' i 'je li'.","role":"user"},{"content":"Oboje uvodi pitanja, ali se razlikuju po mjestu: 'da li' stoji na početku rečenice (Da li dolaziš?), dok se 'li' veže uz glagol (Dolaziš li?). Oblik 'je li' koristi se uz treće lice (Je li to tačno?).","role":"assistant"}],"metadata":{"author":"agentmujo-team","quality_tier":"GOLD","source":"manual-v0.9-core","verification_status":"human-reviewed"},"task":"bosnian-core","version":"0.1.0"}
{"difficulty":"easy","enable_thinking":false,"id":"amj-bc-0006","language":"bs-ijekavica","messages":[{"content":"Prevedi na bosanski: 'The server needs more memory.'","role":"user"},{"content":"Serveru treba više memorije.","role":"assistant"}],"metadata":{"author":"agentmujo-team","quality_tier":"GOLD","source":"manual-v0.9-core","verification_status":"human-reviewed"},"task":"bosnian-core","version":"0.1.0"}
{"difficulty":"easy","enable_thinking":false,"id":"amj-bc-0007","language":"bs-ijekavica","messages":[{"content":"Prevedi na engleski: 'Disk je skoro pun.'","role":"user"},{"content":"The disk is almost full.","role":"assistant"}],"metadata":{"author":"agentmujo-team","quality_tier":"GOLD","source":"manual-v0.9-core","verification_status":"human-reviewed"},"task":"bosnian-core","version":"0.1.0"}
{"difficulty":"easy","enable_thinking":false,"id":"amj-bc-0008","language":"bs-ijekavica","messages":[{"content":"Sastavi tri rečenice sa riječju 'mlijeko'.","role":"user"},{"content":"1. Svako jutro pijem čašu toplog mlijeka. 2. Za kolač nam treba pola litra mlijeka. 3. Svježe mlijeko čuvaj u frižideru.","role":"assistant"}],"metadata":{"author":"agentmujo-team","quality_tier":"GOLD","source":"manual-v0.9-core","verification_status":"human-reviewed"},"task":"bosnian-core","version":"0.1.0"}
{"difficulty":"easy","enable_thinking":false,"id":"amj-bc-0009","language":"bs-ijekavica","messages":[{"content":"Objasni djetetu šta je internet.","role":"user"},{"content":"Internet je velika mreža koja povezuje kompjutere i telefone širom svijeta. Preko njega možeš gledati filmove, slati poruke prijateljima i učiti nove stvari.","role":"assistant"}],"metadata":{"author":"agentmujo-team","quality_tier":"GOLD","source":"manual-v0.9-core","verification_status":"human-reviewed"},"task":"bosnian-core","version":"0.1.0"}
{"difficulty":"easy","enable_thinking":false,"id":"amj-bc-0010","language":"bs-ijekavica","messages":[{"content":"Napiši uputstvo za kuhanje kafe.","role":"user"},{"content":"U džezvu sipaj vodu i dodaj kafu po ukusu. Stavi na laganu vatru i sačekaj da provri. Skloni sa vatre, sačekaj da se slegne pa posluži.","role":"assistant"}],"metadata":{"author":"agentmujo-team","quality_tier":"GOLD","source":"manual-v0.9-core","verification_status":"human-reviewed"},"task":"bosnian-core","version":"0.1.0"}
{"difficulty":"easy","enable_thinking":false,"id":"amj-bc-0011","language":"bs-ijekavica","messages":[{"content":"Kako si danas?","role":"user"},{"content":"Dobro sam, hvala na pitanju! Spreman sam pomoći — reci samo šta treba.","role":"assistant"}],"metadata":{"author":"agentmujo-team","quality_tier":"GOLD","source":"manual-v0.9-core","verification_status":"human-reviewed"},"task":"bosnian-core","version":"0.1.0"}
{"difficulty":"easy","enable_thinking":false,"id":"amj-bc-0012","language":"bs-ijekavica","messages":[{"content":"Šta je voda hemijski gledano?","role":"user"},{"content":"Voda je spoj vodika i kisika hemijske formule H2O — dva atoma vodika i jedan atom kisika.","role":"assistant"}],"metadata":{"author":"agentmujo-team","quality_tier":"GOLD","source":"manual-v0.9-core","verification_status":"human-reviewed"},"task":"bosnian-core","version":"0.1.0"}
{"difficulty":"medium","enable_thinking":false,"id":"amj-bc-0013","language":"bs-ijekavica","messages":[{"content":"Koja je razlika između 'vrijeme' i 'vrijednost'?","role":"user"},{"content":"Vrijeme označava trajanje ili trenutak (npr. koliko sati je), dok vrijednost označava koliko nešto vrijedi — cijenu, važnost ili moralnu vrijednost.","role":"assistant"}],"metadata":{"author":"agentmujo-team","quality_tier":"GOLD","source":"manual-v0.9-core","verification_status":"human-reviewed"},"task":"bosnian-core","version":"0.1.0"}
{"difficulty":"medium","enable_thinking":false,"id":"amj-bc-0014","language":"bs-ijekavica","messages":[{"content":"Nabroj sedam padeža u bosanskom jeziku.","role":"user"},{"content":"Nominativ (ko/šta), genitiv (koga/čega), dativ (kome/čemu), akuzativ (koga/šta), vokativ (dozivanje), instrumental (s kim/čim), lokativ (o kome/o čemu).","role":"assistant"}],"metadata":{"author":"agentmujo-team","quality_tier":"GOLD","source":"manual-v0.9-core","verification_status":"human-reviewed"},"task":"bosnian-core","version":"0.1.0"}
{"difficulty":"medium","enable_thinking":false,"id":"amj-bc-0015","language":"bs-ijekavica","messages":[{"content":"Prevedi na bosanski: 'Please restart the service and verify the status.'","role":"user"},{"content":"Molim te, restartuj servis i provjeri status.","role":"assistant"}],"metadata":{"author":"agentmujo-team","quality_tier":"GOLD","source":"manual-v0.9-core","verification_status":"human-reviewed"},"task":"bosnian-core","version":"0.1.0"}
{"difficulty":"easy","enable_thinking":false,"id":"amj-bc-0016","language":"bs-ijekavica","messages":[{"content":"Sažmi u jednoj rečenici: 'Sarajevo je glavni grad Bosne i Hercegovine, smješten u kotlini rijeke Miljacke, poznat po Baščaršiji i multikulturalnoj historiji.'","role":"user"},{"content":"Sarajevo je glavni grad BiH u kotlini Miljacke, poznat po Baščaršiji i multikulturalnoj historiji.","role":"assistant"}],"metadata":{"author":"agentmujo-team","quality_tier":"GOLD","source":"manual-v0.9-core","verification_status":"human-reviewed"},"task":"bosnian-core","version":"0.1.0"}
{"difficulty":"easy","enable_thinking":false,"id":"amj-bc-0017","language":"bs-ijekavica","messages":[{"content":"Koji je glavni grad Bosne i Hercegovine?","role":"user"},{"content":"Glavni grad Bosne i Hercegovine je Sarajevo.","role":"assistant"}],"metadata":{"author":"agentmujo-team","quality_tier":"GOLD","source":"manual-v0.9-core","verification_status":"human-reviewed"},"task":"bosnian-core","version":"0.1.0"}
{"difficulty":"easy","enable_thinking":false,"id":"amj-bc-0018","language":"bs-ijekavica","messages":[{"content":"Koliko dana ima prijestupna godina?","role":"user"},{"content":"Prijestupna godina ima 366 dana — februar tada ima 29 dana umjesto 28.","role":"assistant"}],"metadata":{"author":"agentmujo-team","quality_tier":"GOLD","source":"manual-v0.9-core","verification_status":"human-reviewed"},"task":"bosnian-core","version":"0.1.0"}
{"difficulty":"medium","enable_thinking":false,"id":"amj-bc-0019","language":"bs-ijekavica","messages":[{"content":"Šta je gravitacija jednostavnim riječima?","role":"user"},{"content":"Gravitacija je sila koja privlači tijela jedno prema drugom — zato jabuka pada na zemlju, a mi stojimo na tlu umjesto da lebdimo.","role":"assistant"}],"metadata":{"author":"agentmujo-team","quality_tier":"GOLD","source":"manual-v0.9-core","verification_status":"human-reviewed"},"task":"bosnian-core","version":"0.1.0"}
{"difficulty":"medium","enable_thinking":false,"id":"amj-bc-0020","language":"bs-ijekavica","messages":[{"content":"Prevedi na engleski: 'Provjeri logove prije restarta.'","role":"user"},{"content":"Check the logs before restarting.","role":"assistant"}],"metadata":{"author":"agentmujo-team","quality_tier":"GOLD","source":"manual-v0.9-core","verification_status":"human-reviewed"},"task":"bosnian-core","version":"0.1.0"}
{"difficulty":"easy","enable_thinking":false,"id":"amj-bc-0021","language":"bs-ijekavica","messages":[{"content":"Šta je struja?","role":"user"},{"content":"Struja je tok električnog naboja kroz provodnik — pokreće uređaje, od sijalice do servera.","role":"assistant"}],"metadata":{"author":"agentmujo-team","quality_tier":"GOLD","source":"manual-v0.9-core","verification_status":"human-reviewed"},"task":"bosnian-core","version":"0.1.0"}
{"difficulty":"easy","enable_thinking":false,"id":"amj-bc-0022","language":"bs-ijekavica","messages":[{"content":"Napiši pozdravnu poruku za goste.","role":"user"},{"content":"Dobrodošli! Drago nam je što ste tu — osjećajte se kao kod kuće.","role":"assistant"}],"metadata":{"author":"agentmujo-team","quality_tier":"GOLD","source":"manual-v0.9-core","verification_status":"human-reviewed"},"task":"bosnian-core","version":"0.1.0"}
{"difficulty":"medium","enable_thinking":false,"id":"amj-bc-0023","language":"bs-ijekavica","messages":[{"content":"Koja je razlika između 'svijet' i 'svjetlo'?","role":"user"},{"content":"Svijet je sve što postoji oko nas (planeta, društvo), dok je svjetlo ono što nam omogućava da vidimo — sunčeva svjetlost ili svjetlost sijalice.","role":"assistant"}],"metadata":{"author":"agentmujo-team","quality_tier":"GOLD","source":"manual-v0.9-core","verification_status":"human-reviewed"},"task":"bosnian-core","version":"0.1.0"}
{"difficulty":"medium","enable_thinking":false,"id":"amj-bc-0024","language":"bs-ijekavica","messages":[{"content":"Prevedi na bosanski: 'Never assume the action succeeded, always verify.'","role":"user"},{"content":"Nikada ne pretpostavljaj da je akcija uspjela, uvijek provjeri.","role":"assistant"}],"metadata":{"author":"agentmujo-team","quality_tier":"GOLD","source":"manual-v0.9-core","verification_status":"human-reviewed"},"task":"bosnian-core","version":"0.1.0"}
{"difficulty":"easy","enable_thinking":false,"id":"amj-bc-0025","language":"bs-ijekavica","messages":[{"content":"Šta je knjiga?","role":"user"},{"content":"Knjiga je skup povezanih stranica sa tekstom — prenosi znanje, priče i ideje kroz generacije.","role":"assistant"}],"metadata":{"author":"agentmujo-team","quality_tier":"SILVER","source":"manual-v0.9-core","verification_status":"human-reviewed"},"task":"bosnian-core","version":"0.1.0"}
{"difficulty":"easy","enable_thinking":false,"id":"amj-bc-0026","language":"bs-ijekavica","messages":[{"content":"Koliko je 7 puta 8?","role":"user"},{"content":"7 puta 8 je 56.","role":"assistant"}],"metadata":{"author":"agentmujo-team","quality_tier":"GOLD","source":"manual-v0.9-core","verification_status":"human-reviewed"},"task":"bosnian-core","version":"0.1.0"}
{"difficulty":"easy","enable_thinking":false,"id":"amj-bc-0027","language":"bs-ijekavica","messages":[{"content":"Koje godišnje doba dolazi poslije ljeta?","role":"user"},{"content":"Poslije ljeta dolazi jesen.","role":"assistant"}],"metadata":{"author":"agentmujo-team","quality_tier":"GOLD","source":"manual-v0.9-core","verification_status":"human-reviewed"},"task":"bosnian-core","version":"0.1.0"}
{"difficulty":"medium","enable_thinking":false,"id":"amj-bc-0028","language":"bs-ijekavica","messages":[{"content":"Zašto je nebo plavo?","role":"user"},{"content":"Nebo je plavo jer molekule zraka raspršuju sunčevu svjetlost, a plava boja se raspršuje najjače — to se zove Rayleighovo raspršenje.","role":"assistant"}],"metadata":{"author":"agentmujo-team","quality_tier":"GOLD","source":"manual-v0.9-core","verification_status":"human-reviewed"},"task":"bosnian-core","version":"0.1.0"}
{"difficulty":"medium","enable_thinking":false,"id":"amj-bc-0029","language":"bs-ijekavica","messages":[{"content":"Prevedi na engleski: 'Sigurnost je važnija od brzine.'","role":"user"},{"content":"Security matters more than speed.","role":"assistant"}],"metadata":{"author":"agentmujo-team","quality_tier":"GOLD","source":"manual-v0.9-core","verification_status":"human-reviewed"},"task":"bosnian-core","version":"0.1.0"}
