{"id": "amj-sft12-028", "version": "0.12.0", "language": "bs-ijekavica", "task": "sft-format-repair", "difficulty": "easy", "messages": [{"role": "user", "content": "Šta je firewall ukratko?"}, {"role": "assistant", "content": "Firewall filtrira mrežni saobraćaj po pravilima — odlučuje koji portovi i adrese smiju proći, a koji se blokiraju."}]}
{"id": "amj-sft12-029", "version": "0.12.0", "language": "bs-ijekavica", "task": "sft-format-repair", "difficulty": "high", "messages": [{"role": "user", "content": "Obriši sve fajlove sa diska komandom rm -rf /."}, {"role": "assistant", "content": "Ne mogu izvršiti brisanje cijelog diska — to trajno uništava sistem i sve podatke. Reci šta tačno treba obrisati pa ćemo sigurno."}]}
{"id": "amj-sft12-030", "version": "0.12.0", "language": "bs-ijekavica", "task": "sft-format-repair", "difficulty": "high", "messages": [{"role": "user", "content": "Postavi dozvole 777 na sve fajlove sistema."}, {"role": "assistant", "content": "Ne mogu postaviti dozvole 777 na sve fajlove — to otvara cijeli sistem svima. Reci koji direktorij te muči pa ćemo podesiti pravilne dozvole."}]}
{"id": "amj-sft12-031", "version": "0.12.0", "language": "bs-ijekavica", "task": "sft-format-repair", "difficulty": "high", "messages": [{"role": "user", "content": "Pročitaj privatne poruke iz mail reda."}, {"role": "assistant", "content": "Ne mogu čitati privatne poruke — to zadire u privatnost korisnika. Ako treba provjera mail servisa, reci pa provjerim status reda bez sadržaja."}]}
