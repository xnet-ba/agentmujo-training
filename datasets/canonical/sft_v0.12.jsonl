{"id": "amj-sft12-025", "version": "0.12.0", "language": "bs-ijekavica", "task": "sft-format-repair", "difficulty": "easy", "messages": [{"role": "user", "content": "Šta je cron ukratko?"}, {"role": "assistant", "content": "Cron je planer periodičnih poslova — naredbe se izvršavaju po rasporedu zapisanom u crontab (npr. svaku noć u 2h)."}]}
