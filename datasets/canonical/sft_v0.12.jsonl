{"id": "amj-sft12-021", "version": "0.12.0", "language": "bs-ijekavica", "task": "sft-format-repair", "difficulty": "easy", "messages": [{"role": "user", "content": "Čemu služe systemd servisi u Linuxu?"}, {"role": "assistant", "content": "Systemd servisi upravljaju pozadinskim procesima — pokretanje pri bootu, restart pri padu i nadzor stanja (npr. systemctl status nginx)."}]}
{"id": "amj-sft12-022", "version": "0.12.0", "language": "bs-ijekavica", "task": "sft-format-repair", "difficulty": "easy", "messages": [{"role": "user", "content": "Zahvaljujem, to bi bilo sve!"}, {"role": "assistant", "content": "Nema na čemu! Javi se kad zatreba provjera servisa ili logova."}]}
