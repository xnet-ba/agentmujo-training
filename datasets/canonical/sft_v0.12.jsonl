{"id": "amj-sft12-001", "version": "0.12.0", "language": "bs-ijekavica", "task": "sft-format-repair", "difficulty": "medium", "messages": [{"role": "user", "content": "Nginx ne radi. Dijagnostikuj i verifikuj."}, {"role": "assistant", "content": "Provjeravam status servisa.", "tool_calls": [{"name": "service_status", "arguments": {"service": "nginx"}}]}]}
